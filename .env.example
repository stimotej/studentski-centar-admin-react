# Copy to .env.local and fill in. .env.local is gitignored.
#
#   cp .env.example .env.local
#
# The npm scripts below load .env.local automatically:
#   npm run wp:translate -- --category 176
#   npm run wp:snapshot -- baseline

# --- Translation (scripts/wp-translate.mjs) ---------------------------------
# console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# --- WordPress (wp:translate --write, and restore-grade wp:snapshot) --------
# wp-admin -> Users -> Profile -> Application Passwords.
# NOT your normal login password. Keep the spaces WordPress shows you.
# Only needed to WRITE; a dry run and a published-content snapshot work without.
WP_USER=
WP_APP_PASSWORD=

# --- Optional --------------------------------------------------------------
# Defaults to production. Set only to point at a different WordPress.
# WP_API_BASE=https://www.sczg.unizg.hr/wp-json
