# Copy to .env.local and fill in. .env.local is gitignored.
#
#   cp .env.example .env.local
#
# The npm scripts below load .env.local automatically:
#   npm run wp:translate -- --category 176
#   npm run wp:snapshot -- baseline

# --- Translation (scripts/wp-translate.mjs) ---------------------------------
# Pick ONE route for the model.
#
# A) Vercel AI Gateway — spends Vercel credits, zero markup, usage visible in
#    the Vercel dashboard. Key from: Vercel dashboard -> AI Gateway -> API keys.
#    Takes precedence if both are set.
AI_GATEWAY_API_KEY=

# B) Anthropic directly — console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Optional model override. Gateway ids are provider-prefixed and dot-versioned
# (anthropic/claude-opus-4.6); direct ids are bare (claude-opus-5).
# TRANSLATE_MODEL=

# --- WordPress (wp:translate --write, and restore-grade wp:snapshot) --------
# wp-admin -> Users -> Profile -> Application Passwords.
# NOT your normal login password. Keep the spaces WordPress shows you.
# Only needed to WRITE; a dry run and a published-content snapshot work without.
WP_USER=
WP_APP_PASSWORD=

# --- Optional --------------------------------------------------------------
# Defaults to production. Set only to point at a different WordPress.
# WP_API_BASE=https://www.sczg.unizg.hr/wp-json
